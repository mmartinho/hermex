{
  "mcpServers": {
    "github-hermex": {
      "type": "http",
      "url": "https://api.githubcopilot.com/mcp/",
      "headers": {
        "Authorization": "Bearer ${GITHUB_PAT}",
        "X-MCP-Toolsets": "code_security,context,repos,issues,pull_requests,discussions",
        "X-MCP-Readonly": "true"
      }
    },
    "linear-server": {
      "type": "http",
      "url": "https://mcp.linear.app/mcp"
    }
  }
}
