# Copie para apps/web/.env.local

# Auth.js — gere com `npx auth secret` ou `openssl rand -base64 32`
AUTH_SECRET=troque-este-segredo
AUTH_URL=http://localhost:3000
AUTH_TRUST_HOST=true

# Google OAuth (https://console.cloud.google.com/apis/credentials)
# URI de redirecionamento: http://localhost:3000/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Facebook OAuth (https://developers.facebook.com/apps)
# URI de redirecionamento: http://localhost:3000/api/auth/callback/facebook
AUTH_FACEBOOK_ID=
AUTH_FACEBOOK_SECRET=

# API Nest (usada somente no servidor Next)
API_GRAPHQL_URL=http://localhost:4000/graphql
# Mesmo valor de INTERNAL_API_KEY em apps/api/.env
INTERNAL_API_KEY=troque-esta-chave-interna
