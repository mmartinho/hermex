// Data Atualização: 2026-11-25
// Descrição: Schema do banco de dados do Hermex (Postgres). Contém os modelos de autenticação,
//   User (usuários) e Account (contas de login social vinculadas), a frota (Vehicle), as
//   categorias de veículos (Category) e os locais de retirada e devolução (Location).

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
  runtime      = "nodejs"
}

datasource db {
  provider = "postgresql"
}

/// Papéis de acesso. Manter em sincronia com `UserRole` de @hermex/shared.
enum UserRole {
  ADMIN
  CUSTOMER
}

/// Provedores de login social. Manter em sincronia com `AuthProvider` de @hermex/shared.
enum AuthProvider {
  GOOGLE
  FACEBOOK
}

/// Usuário do sistema (cliente da locadora ou administrador).
model User {
  id            String    @id @default(uuid())
  email         String    @unique
  /// Data em que o email foi confirmado (ex.: por um provedor social confiável).
  emailVerified DateTime?
  name          String
  /// URL da foto de perfil (normalmente vinda do provedor social).
  image         String?
  /// Hash bcrypt da senha. Nulo para quem só entra via login social.
  passwordHash  String?
  role          UserRole  @default(CUSTOMER)
  accounts      Account[]
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@map("users")
}

/// Conta de um provedor social vinculada a um usuário.
model Account {
  id                String       @id @default(uuid())
  userId            String
  user              User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider          AuthProvider
  /// Id do usuário dentro do provedor (ex.: `sub` do Google).
  providerAccountId String
  createdAt         DateTime     @default(now())

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("accounts")
}

/// Veículo da frota da locadora.
model Vehicle {
  id           String   @id @default(uuid())
  /// Marca (ex.: Hyundai).
  brand        String
  /// Modelo (ex.: HB20).
  model        String
  /// Ano do modelo.
  year         Int
  /// Placa do veículo, única na frota.
  licensePlate String   @unique
  /// Valor da diária em reais. Decimal para não perder centavos com ponto flutuante.
  dailyRate    Decimal  @db.Decimal(10, 2)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("vehicles")
}

/// Categoria de veículo (ex.: SUV, Sedan).
model Category {
  id        String   @id @default(cuid())
  name      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("categories")
}

/// Filial/ponto de retirada e devolução de veículos.
model Location {
  id        String   @id @default(cuid())
  name      String   @unique
  address   String
  city      String
  /// Sigla da UF (ex.: SP).
  state     String   @db.Char(2)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("locations")
}
