# Copie para apps/api/.env
NODE_ENV=development
PORT=4000
CORS_ORIGIN=http://localhost:3000

# Postgres (mesmos valores do .env da raiz / docker-compose)
DATABASE_URL=postgresql://hermex:hermex@localhost:5432/hermex?schema=public

# JWT emitido pela API (gere um segredo forte: `openssl rand -base64 32`)
JWT_SECRET=troque-este-segredo
JWT_EXPIRES_IN=7d

# Chave compartilhada SOMENTE entre os servidores Next e Nest (mesmo valor em apps/web/.env.local)
INTERNAL_API_KEY=troque-esta-chave-interna

# Seed do usuário administrador
SEED_ADMIN_EMAIL=admin@hermex.local
SEED_ADMIN_PASSWORD=Admin@123
